+﻿# Normalize an IPv6 address into 8 zero padded 4 digit hex groups.
+# $1	IPv6 address
+# Print the expanded address, or nothing when it cannot be parsed.
+ipv6_expand() {
+	awk '{
+		a = tolower($1);
+		if (index(a, "::")) {
+			split(a, half, "::");
+			ln = (half[1] == "") ? 0 : split(half[1], lg, ":");
+			rn = (half[2] == "") ? 0 : split(half[2], rg, ":");
+			miss = 8 - ln - rn;
+			if (miss < 1) { print ""; exit }
+			xpadded = half[1];
+			for (i = 0; i < miss; i++)
+				xpadded = xpadded (xpadded == "" ? "" : ":") "0";
+			if (rn > 0)
+				xpadded = xpadded ":" half[2];
+		} else {
+			xpadded = a;
+		}
+		if (split(xpadded, g, ":") != 8) { print ""; exit }
+		out = "";
+		for (i = 1; i <= 8; i++) {
+			if (g[i] !~ /^[0-9a-f]+$/ || length(g[i]) > 4) { print ""; exit }
+			out = out (i > 1 ? ":" : "") sprintf("%04x", strtonum("0x" g[i]));
+		}
+		print out;
+	}' <<EOF
+$1
+EOF
+}
+
+# Print the normalized /64 prefix of an IPv6 address.
+# $1	IPv6 address
+ipv6_prefix64() {
+	local __Expanded
+	__Expanded=$(ipv6_expand "$1")
+	[ -n "$__Expanded" ] || return 1
+	echo "$__Expanded" | cut -d: -f1-4
+}
+
+# Check whether an IPv6 address belongs to one of the given /64 prefixes.
+# $1	IPv6 address
+# $2	space separated list of normalized /64 prefixes
+is_ipv6_in_prefixes() {
+	local __Prefix __AddrPrefix
+
+	__AddrPrefix=$(ipv6_prefix64 "$1")
+	[ -n "$__AddrPrefix" ] || return 1
+
+	for __Prefix in $2; do
+		[ "$__Prefix" = "$__AddrPrefix" ] && return 0
+	done
+	return 1
+}
+
+# Print the /64 prefixes currently configured on an interface.
+# $1	Interface name, defaults to $ip_mac_interface
+get_ipv6_lan_prefixes() {
+	local __Iface __Entry __Prefix
+
+	__Iface="$1"
+	[ -n "$__Iface" ] || __Iface="$ip_mac_interface"
+	[ -n "$__Iface" ] || return 0
+
+	ip -6 -o addr show dev "$__Iface" scope global 2>/dev/null |
+		awk '{ print $4 }' |
+		while :; do
+			read -r __Entry || break
+			case "$__Entry" in
+				*/64)
+					__Prefix=$(ipv6_prefix64 "${__Entry%/64}")
+					[ -n "$__Prefix" ] && echo "$__Prefix"
+					;;
+			esac
+		done | sort -u
+}
+
+get_ipv6_by_mac() {
+	# $1	Name of Variable to store the selected IPv6 address
+	local __IpVar __Mac __Prefixes __HavePrefix __Candidates __Addr __Chosen
+	local __ChosenPrefix
+
+	__IpVar="$1"
+
+	[ -z "$__IpVar" ] && {
+		write_log 12 "get_ipv6_by_mac: Missing variable name for IPv6 storage"
+		return 1
+	}
+
+	[ "$use_ipv6" -eq 1 ] || {
+		write_log 12 "get_ipv6_by_mac: MAC source is only valid for IPv6"
+		return 2
+	}
+
+	[ -n "$ip_mac" ] || {
+		write_log 12 "get_ipv6_by_mac: 'ip_mac' not set for source 'mac'"
+		return 2
+	}
+
+	case "$ip_mac" in
+		[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f])
+			;;
+		*)
+			write_log 12 "get_ipv6_by_mac: Invalid MAC address '$ip_mac'"
+			return 2
+			;;
+	esac
+
+	write_log 7 "MAC address: $ip_mac"
+
+	__Mac=$(printf '%s' "$ip_mac" | tr '[:upper:]' '[:lower:]')
+
+	# ISP delegated prefixes change regularly. While the prefix changes the
+	# neighbor table holds addresses from both the withdrawn and the new
+	# prefix, and the withdrawn one is often still REACHABLE because the
+	# device keeps using it. Such an address must never win over one that
+	# belongs to the prefix the LAN is configured with right now.
+	__Prefixes=$(get_ipv6_lan_prefixes "$ip_mac_interface")
+	__HavePrefix=0
+	[ -n "$__Prefixes" ] && __HavePrefix=1
+	if [ "$__HavePrefix" -eq 1 ]; then
+		write_log 7 "Current LAN /64 prefix(es): $(echo $__Prefixes)"
+	else
+		write_log 7 "No current LAN /64 prefix detected, prefix preference disabled"
+	fi
+
+	__Candidates=$(ip -6 neigh show 2>/dev/null |
+		awk -v mac="$__Mac" -v allow_private="$upd_privateip" \
+		    -v have_prefix="$__HavePrefix" -v prefixes="$(echo $__Prefixes)" '
+			BEGIN {
+				n = split(prefixes, p, " ");
+				for (i = 1; i <= n; i++)
+					known[p[i]] = 1;
+			}
+			{
+				addr = tolower($1);
+
+				mac_index = 0;
+				for (i = 1; i < NF; i++) {
+					if (tolower($i) == "lladdr") {
+						mac_index = i + 1;
+						break;
+					}
+				}
+
+				# Do not assume a fixed column: optional flags such as "router"
+				# may appear between lladdr and the neighbor state.
+				if (mac_index == 0 || tolower($(mac_index)) != mac)
+					next;
+
+				state = toupper($NF);
+
+				if (addr == "::" || addr == "::1" ||
+				    addr ~ /^fe[89ab]/ || addr ~ /^ff/)
+					next;
+
+				if (!allow_private && (addr ~ /^fc/ || addr ~ /^fd/))
+					next;
+
+				# Expand to eight groups so the /64 and the IID can be read.
+				xpadded = addr;
+				if (index(xpadded, "::")) {
+					split(xpadded, half, "::");
+					ln = (half[1] == "") ? 0 : split(half[1], lg, ":");
+					rn = (half[2] == "") ? 0 : split(half[2], rg, ":");
+					miss = 8 - ln - rn;
+					if (miss < 1)
+						next;
+					xpadded = half[1];
+					for (i = 0; i < miss; i++)
+						xpadded = xpadded (xpadded == "" ? "" : ":") "0";
+					if (rn > 0)
+						xpadded = xpadded ":" half[2];
+				}
+				if (split(xpadded, g, ":") != 8)
+					next;
+
+				# Rebuild the address with normalized groups and take the /64.
+				norm = "";
+				prefix = "";
+				for (i = 1; i <= 8; i++) {
+					grp = sprintf("%04x", strtonum("0x" g[i]));
+					norm = norm (i > 1 ? ":" : "") grp;
+					if (i <= 4)
+						prefix = prefix (i > 1 ? ":" : "") grp;
+				}
+
+				# Sort key 1: addresses in a currently configured LAN /64 win
+				# over leftovers from a withdrawn delegated prefix.
+				if (have_prefix == 1)
+					prefix_rank = known[prefix] ? 0 : 1;
+				else
+					prefix_rank = 0;
+
+				# Sort key 2: neighbor state freshness.
+				if (state == "REACHABLE")
+					state_rank = 0;
+				else if (state == "DELAY")
+					state_rank = 1;
+				else if (state == "PROBE")
+					state_rank = 2;
+				else if (state == "STALE")
+					state_rank = 3;
+				else if (state == "PERMANENT")
+					state_rank = 4;
+				else
+					next;	# FAILED / INCOMPLETE / NOARP are never usable
+
+				# Sort key 3: an EUI-64 interface identifier (ff:fe in the
+				# middle of the IID) derives from the hardware address and is
+				# the most stable form a device can use. RFC 4941 temporary
+				# addresses cannot be identified reliably from the neighbor
+				# table, so they are ranked after EUI-64 but never dropped.
+				iid = "";
+				for (i = 5; i <= 8; i++)
+					iid = iid sprintf("%04x", strtonum("0x" g[i]));
+				iid_rank = (index(iid, "fffe") == 5) ? 0 : 1;
+
+				# Sort key 4: the expanded address, so the result does not
+				# depend on the order the kernel happens to list neighbors.
+				print prefix_rank "\t" state_rank "\t" iid_rank "\t" norm "\t" addr;
+			}
+		' |
+		sort -k1,1n -k2,2n -k3,3n -k4,4 |
+		head -n 1 |
+		cut -f5-)
+
+	[ -n "$__Candidates" ] || {
+		write_log 3 "No usable IPv6 neighbor found for MAC '$ip_mac'"
+		return 1
+	}
+
+	# Safety valve for delegated prefix changes: when none of the candidates
+	# belongs to a currently configured LAN /64 the address is a leftover from
+	# a withdrawn prefix. Publishing it would point the DDNS record at an
+	# unreachable address, so fail here and let the normal ddns-scripts retry
+	# loop try again once the device has picked up the new prefix.
+	if [ "$__HavePrefix" -eq 1 ]; then
+		if ! is_ipv6_in_prefixes "$__Candidates" "$__Prefixes"; then
+			__ChosenPrefix=$(ipv6_prefix64 "$__Candidates")
+			write_log 3 "No IPv6 neighbor for MAC '$ip_mac' inside the current LAN /64 prefix (candidate '$__Candidates' is in '$__ChosenPrefix'), refusing to update"
+			return 1
+		fi
+	fi
+
+	__Addr="$__Candidates"
+	eval "$__IpVar=\$__Addr"
+	write_log 7 "Found IPv6 address: $__Addr"
+	return 0
+}
